# Copy values into your server process environment. Do not place real keys in this file.
AI_LISTEN_HOST=127.0.0.1
AI_LISTEN_PORT=8765
AI_UPSTREAM_BASE_URL=https://api.deepseek.com
AI_UPSTREAM_MODEL=deepseek-flash
AI_UPSTREAM_THINKING=disabled
AI_UPSTREAM_API_KEY=replace-on-server-only

# For a non-local deployment, require distinct client access tokens and HTTPS at the proxy.
# AI_CLIENT_TOKENS=replace-with-random-access-tokens
AI_RATE_PER_MINUTE=12
AI_DAILY_REQUEST_LIMIT=80
AI_MAX_CONCURRENT=2
AI_MAX_OUTPUT_TOKENS=4096
