[
  {
  "poetId": "taoyuanming",
  "subtitle": "误落尘网中，一去三十年",
  "stops": [
    {
      "id": "taoyuanming-chaisang-birth",
      "year": 352,
      "date": "约352",
      "place": "柴桑 · 故里",
      "lon": 115.78,
      "lat": 29.71,
      "stage": 0,
      "uncertain": true,
      "event": "生于柴桑",
      "detail": "陶渊明出生于浔阳柴桑，家族曾经显赫，到他一代家道衰落。少年博览群书，同时受老庄思想熏陶，心中同时并存济世报国与向往山林的两种理想。",
      "context": "古柴桑大致在今江西九江一带，点位为现代地理参考。",
      "source": "https://www.dpm.org.cn/lemmas/238044.html"
    },
    {
      "id": "taoyuanming-jiangling",
      "year": 394,
      "date": "约394",
      "place": "江陵",
      "lon": 112.25,
      "lat": 30.34,
      "stage": 1,
      "uncertain": true,
      "event": "初入桓玄幕府",
      "detail": "为生活与理想，陶渊明进入桓玄幕府任职。身处乱世军阀幕府，亲眼目睹朝堂纷争、权力倾轧，官场现实和内心向往的自由产生剧烈冲突，退隐的念头不断滋生。",
      "context": "江陵即今湖北荆州。",
      "source": "https://www.dpm.org.cn/lemmas/238044.html"
    },
    {
      "id": "taoyuanming-chaisang-mu",
      "year": 401,
      "date": "约401",
      "place": "柴桑",
      "lon": 115.78,
      "lat": 29.71,
      "stage": 1,
      "uncertain": true,
      "event": "母丧归乡，暂时归隐",
      "detail": "母亲去世，陶渊明离职回乡守孝。在家乡度过一段读书闲居的田园时光，真切感受村居之美。但家庭经济压力沉重，守孝结束之后，不得不再次出仕谋生。",
      "context": "古柴桑即今江西九江周边。",
      "source": "https://www.dpm.org.cn/lemmas/238044.html"
    },
    {
      "id": "taoyuanming-pengze",
      "year": 405,
      "date": "405",
      "place": "彭泽",
      "lon": 116.56,
      "lat": 29.89,
      "stage": 2,
      "uncertain": false,
      "event": "彭泽辞官，不为五斗米折腰",
      "detail": "出任彭泽县令，仅仅八十余日，不愿卑躬屈膝逢迎上官，毅然解印辞官。这是他人生重大抉择，从此彻底告别官场，走向终身田园躬耕的道路。",
      "context": "古彭泽县，点位取今江西彭泽县参考。",
      "source": "https://www.dpm.org.cn/lemmas/238044.html"
    },
    {
      "id": "taoyuanming-chaisang-return",
      "year": 405,
      "date": "405",
      "place": "柴桑",
      "lon": 115.78,
      "lat": 29.71,
      "stage": 2,
      "uncertain": false,
      "event": "写下归去来兮辞",
      "detail": "辞官归返柴桑途中，写下《归去来兮辞》。抒发挣脱官场枷锁，回归田园的无限喜悦，对过往误入仕途做出反思，确立往后人生的精神方向。",
      "context": "回到故乡柴桑，开启正式归田生活。",
      "source": "https://www.dpm.org.cn/lemmas/238044.html"
    },
    {
      "id": "taoyuanming-chaisang-fire",
      "year": 420,
      "date": "约420",
      "place": "柴桑",
      "lon": 115.78,
      "lat": 29.71,
      "stage": 3,
      "uncertain": true,
      "event": "柴桑遭火，生计艰难",
      "detail": "归隐之后家中遭遇大火，房屋焚毁，田产又屡受灾荒。躬耕依旧难以温饱，全家时常陷入饥寒。即便如此，陶渊明依然拒绝世俗势力的馈赠征召，坚守自己的志节。",
      "context": "柴桑故里，晚年生活困苦。",
      "source": "https://www.dpm.org.cn/lemmas/238044.html"
    },
    {
      "id": "taoyuanming-chaisang-death",
      "year": 427,
      "date": "427",
      "place": "柴桑",
      "lon": 115.78,
      "lat": 29.71,
      "stage": 3,
      "uncertain": false,
      "event": "贫病离世",
      "detail": "长年贫病交加，陶渊明在柴桑走完一生。他把农耕、饮酒、村居日常写入诗文，开创中国田园诗流派；《桃花源记》寄托乱世中对安宁世界的美好想象，深刻影响后世文人精神世界。",
      "context": "点位取江西九江柴桑故地参考。",
      "source": "https://www.dpm.org.cn/lemmas/238044.html"
    }
  ]
},
  {
    "poetId": "libai",
    "subtitle": "蜀中少年，长安一梦，江山万里",
    "stops": [
      {
